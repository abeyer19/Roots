{
  "name": "Root",
  "displayName": "Root",
  "description": "Interactive codebase architecture and dependency visualizer.",
  "version": "1.0.0",
  "publisher": "abeyer19",
  "repository": {
    "type": "git",
    "url": "https://github.com/abeyer19/Roots.git"
  },
  "icon": "media/roots.jpg",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "activationEvents": [
    "onCommand:pyGraph.visualize"
  ],
  "main": "./extension.js",
  "scripts": {
    "test:python": "python3 -m unittest test_parser.py"
  },
  "contributes": {
    "commands": [
      {
        "command": "pyGraph.visualize",
        "title": "Roots Visualizer"
      }
    ],
    "configuration": {
      "title": "Roots Visualizer",
      "properties": {
        "roots.ignoredDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git",
            "__pycache__",
            "venv",
            ".venv",
            "node_modules"
          ],
          "description": "Directories to explicitly exclude from the architecture graph."
        },
        "roots.allowedExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".py",
            ".json",
            ".env"
          ],
          "description": "File extensions allowed to be processed and displayed in the graph."
        },
        "roots.allowedHiddenFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".env"
          ],
          "description": "Hidden files (prefixed with '.') explicitly permitted in the graph."
        }
      }
    }
  }
}